    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "chromatic": "^16.10.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "^4.9.5",
    "util": "^0.12.5"
  }
