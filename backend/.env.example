# Copy to .env and fill in real values. .env is gitignored.
SECRET_KEY=generate-a-django-secret-key
DB_NAME=webcoder_db
DB_USER=webcoder_user
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5433

# Judge execution backend: "local" (dev; judged commands run directly on the
# host) or "container" (prod; judged commands run inside the sandboxed
# judge-runner container from the repo-root docker-compose.yml).
JUDGE_BACKEND=local
